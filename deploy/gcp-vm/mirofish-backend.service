[Unit]
Description=MiroFish backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirofish
Group=mirofish
WorkingDirectory=/opt/mirofish/app/backend
EnvironmentFile=/etc/mirofish/mirofish.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mirofish/app/backend/.venv/bin/gunicorn --bind 127.0.0.1:5001 --workers 2 --threads 4 --timeout 900 'app:create_app()'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mirofish/app/backend/uploads

[Install]
WantedBy=multi-user.target
