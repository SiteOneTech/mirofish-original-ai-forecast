FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5002
SECRET_KEY=replace-with-random-secret

# OpenAI-compatible LLM endpoint for graph extraction and reports.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=

# Graphiti local graph backend. Do not set ZEP_* in this staging env.
GRAPH_BACKEND=graphiti
GRAPHITI_URI=bolt://127.0.0.1:7687
GRAPHITI_USER=neo4j
GRAPHITI_PASSWORD=
GRAPHITI_DATABASE=neo4j
GRAPHITI_LLM_CLIENT_MODE=generic
GRAPHITI_USE_RESPONSE_FORMAT=false
GRAPHITI_LLM_MAX_TOKENS=8192

# Local OpenAI-compatible embeddings via Ollama.
GRAPHITI_EMBEDDER_API_KEY=ollama
GRAPHITI_EMBEDDER_BASE_URL=http://127.0.0.1:11434/v1
GRAPHITI_EMBEDDER_MODEL=nomic-embed-text
GRAPHITI_EMBEDDER_DIM=768

GRAPH_SEARCH_RERANKER=rrf
GRAPH_SEARCH_APP_RERANKER=lexical
GRAPHITI_ENABLE_CROSS_ENCODER=false

OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
